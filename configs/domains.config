# Harley's Clan Forum — Domain Registry
# Used by HCF Android builds for trusted in-app forum URL routing.
# Keep this file text-based and easy to edit.

[config]
version=1
https_only=true
open_registered_domains_in_app=true
preserve_path=true
preserve_query=true
preserve_fragment=true

[primary]
domain=forum.harleytg.com

[backups]
domain_1=forum.harleytg.online
domain_2=harleysclan.freeflarum.com

[routing]
external_domains=browser
unknown_hcf_domain=browser
