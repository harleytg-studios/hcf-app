# Harley's Clan Forum Android ban-system runtime configuration
# Public settings only. Never put Discord or GitHub secrets in this file.

[config]
version=2
enabled=true
fail_mode=open
config_refresh_hours=6

[ban_list]
url=https://raw.githubusercontent.com/markhitchk/hcf-app/main/configs/ban-list.json

[ip_lookup]
primary=https://api.ipify.org?format=json
fallback=https://ipinfo.io/json

[privacy]
store_email=false
store_cookies=false
store_tokens=false
store_messages=false
publish_raw_ips=false
