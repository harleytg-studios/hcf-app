# Harley's Clan Forum Android ban-system runtime configuration
# Public settings only. Never put GitHub or Firebase secrets in this file.

[config]
version=1
enabled=false
fail_mode=open
config_refresh_hours=6

[endpoint]
observe_url=https://us-west1-hcf-9ad64.cloudfunctions.net/hcfBanApi/v1/observe

[ip_lookup]
primary=https://api.ipify.org?format=json
fallback=https://ipinfo.io/json

[privacy]
store_email=false
store_cookies=false
store_tokens=false
store_messages=false
