<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:background="@color/hcf_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mainShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/topAppBar"
            android:background="@drawable/top_bar_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_header_height"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/drawerButtonFrame"
                android:layout_width="@dimen/app_header_button"
                android:layout_height="@dimen/app_header_button">
                <ImageButton
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/drawerButton"
                    android:background="@drawable/nav_button_background"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fa_bars"
                    android:scaleType="center"
                    android:tint="@color/hcf_cyan_bright"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/drawer"/>
            </FrameLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/appHeaderLogo"
                android:layout_width="@dimen/app_header_logo"
                android:layout_height="@dimen/app_header_logo"
                android:src="@drawable/htg_app_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:layout_marginStart="7dp"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="@dimen/app_header_title_text"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_text"
                    android:ellipsize="end"
                    android:id="@+id/appHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harley&apos;s Clan Forum [Beta]"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_meta"
                    android:ellipsize="end"
                    android:id="@+id/appHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live forum • Primary"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/hcf_cyan_bright"
                android:gravity="center"
                android:id="@+id/liveStatusBadge"
                android:background="@drawable/live_badge_background"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="48dp"
                android:text="Live"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="6dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/notificationButtonFrame"
                android:layout_width="@dimen/app_header_button"
                android:layout_height="@dimen/app_header_button">
                <ImageButton
                    android:gravity="center"
                    android:id="@+id/headerNotificationsButton"
                    android:background="@drawable/nav_button_background"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/fa_bell"
                    android:scaleType="center"
                    android:tint="@color/hcf_cyan_bright"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="Forum notifications"/>
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_bg"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/headerNotificationCountBadge"
                    android:background="@drawable/notification_count_badge"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:minWidth="18dp"
                    android:text="2"
                    android:includeFontPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/urlBar"
            android:background="@color/hcf_url_bar"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/url_bar_height"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageButton
                android:gravity="center"
                android:id="@+id/urlBackButton"
                android:background="@drawable/nav_button_background"
                android:padding="0dp"
                android:layout_width="@dimen/url_reload_button"
                android:layout_height="@dimen/url_reload_button"
                android:src="@drawable/fa_arrow_left"
                android:scaleType="center"
                android:tint="@color/hcf_cyan_bright"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="Back"
                android:layout_marginEnd="6dp"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/reloadButton"
                android:background="@drawable/nav_button_background"
                android:padding="0dp"
                android:layout_width="@dimen/url_reload_button"
                android:layout_height="@dimen/url_reload_button"
                android:src="@drawable/fa_rotate_right"
                android:scaleType="center"
                android:tint="@color/hcf_cyan_bright"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="@string/reload"
                android:layout_marginEnd="6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/urlBarInner"
                android:background="@drawable/address_bar_background"
                android:layout_width="0dp"
                android:layout_height="@dimen/url_bar_inner_height"
                android:layout_weight="1">
                <TextView
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_cyan_bright"
                    android:gravity="center"
                    android:id="@+id/hostBadge"
                    android:background="@drawable/status_chip_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/hcf_muted"
                        android:id="@+id/secureForumLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Secure Forum"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/fa_lock"/>
                    <EditText
                        android:textSize="11sp"
                        android:textColor="@color/hcf_text"
                        android:ellipsize="end"
                        android:id="@+id/currentUrlText"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="https://forum.harleytg.com/"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:selectAllOnFocus="false"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionGo"
                        android:textCursorDrawable="@null"/>
                </LinearLayout>
                <ImageButton
                    android:gravity="center"
                    android:id="@+id/copyUrlButton"
                    android:background="@drawable/nav_button_background"
                    android:padding="0dp"
                    android:layout_width="@dimen/url_copy_button"
                    android:layout_height="@dimen/url_copy_button"
                    android:src="@drawable/fa_copy"
                    android:scaleType="center"
                    android:tint="@color/hcf_muted"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/copy_url"/>
            </LinearLayout>
            <ImageButton
                android:gravity="center"
                android:id="@+id/urlHomeButton"
                android:background="@drawable/nav_button_background"
                android:padding="0dp"
                android:layout_width="@dimen/url_reload_button"
                android:layout_height="@dimen/url_reload_button"
                android:src="@drawable/fa_house"
                android:scaleType="center"
                android:tint="@color/hcf_cyan_bright"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="Forum home"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/hcf_cyan_bright"
            android:gravity="center_vertical"
            android:id="@+id/welcomeBanner"
            android:background="@color/hcf_welcome_bg"
            android:paddingTop="@dimen/welcome_vertical_padding"
            android:paddingBottom="@dimen/welcome_vertical_padding"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back • Guest protocol"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:layout_gravity="top"
                android:id="@+id/pageProgress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressTint="@color/hcf_cyan"
                style="?android:attr/progressBarStyleHorizontal"/>
            <FrameLayout
                android:id="@+id/statusOverlay"
                android:background="@color/hcf_bg"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="3dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/startupStateContainer"
                    android:padding="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="@dimen/startup_logo_size"
                        android:layout_height="@dimen/startup_logo_size"
                        android:src="@drawable/htg_app_logo"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"/>
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/hcf_text"
                        android:gravity="center"
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Connecting to Harley&apos;s Clan Forum…"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/hcf_muted"
                        android:gravity="center"
                        android:id="@+id/statusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="forum.harleytg.com"/>
                    <ProgressBar
                        android:id="@+id/startupProgress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/hcf_cyan"
                        style="?android:attr/progressBarStyleLarge"/>
                </LinearLayout>
                <ScrollView
                    android:id="@+id/errorStateScroll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/errorShell"
                            android:background="@drawable/error_shell_background"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/htg_app_logo"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="@string/app_name"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp">
                                    <TextView
                                        android:textSize="19sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_cyan_bright"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Harley&apos;s Clan Forum"/>
                                    <TextView
                                        android:textSize="9sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_muted"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="APP NETWORK // ERROR HANDLER"
                                        android:fontFamily="monospace"/>
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:background="@color/hcf_divider"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <LinearLayout
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingTop="28dp"
                                android:paddingBottom="24dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">
                                <TextView
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/hcf_cyan_bright"
                                    android:id="@+id/errorStatusText"
                                    android:background="@drawable/error_pill_background"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="●  CONNECTION UNAVAILABLE"
                                    android:fontFamily="monospace"/>
                                <TextView
                                    android:textSize="50sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/hcf_cyan_bright"
                                    android:gravity="center"
                                    android:id="@+id/errorHeroText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:text="OFFLINE"/>
                                <TextView
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/hcf_text"
                                    android:gravity="center"
                                    android:id="@+id/errorTitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:text="You&apos;re offline"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/hcf_muted"
                                    android:gravity="center"
                                    android:id="@+id/errorMessageText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="Waiting for an internet connection. The forum will retry automatically."
                                    android:lineSpacingExtra="3dp"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:background="@drawable/error_technical_background"
                                    android:padding="14dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="22dp">
                                    <TextView
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_cyan_bright"
                                        android:id="@+id/errorCodeText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="HCF-NET-001"
                                        android:fontFamily="monospace"/>
                                    <TextView
                                        android:textSize="11sp"
                                        android:textColor="@color/hcf_text"
                                        android:id="@+id/errorTechnicalText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:text="No validated network connection is currently available."
                                        android:fontFamily="monospace"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/errorActions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp">
                                    <Button
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_on_accent"
                                        android:gravity="center"
                                        android:id="@+id/retryButton"
                                        android:background="@drawable/error_primary_button_background"
                                        android:layout_width="0dp"
                                        android:layout_height="54dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:text="Retry"
                                        android:layout_weight="1"
                                        android:textAllCaps="false"/>
                                    <Button
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_cyan_bright"
                                        android:gravity="center"
                                        android:id="@+id/alternateButton"
                                        android:background="@drawable/error_secondary_button_background"
                                        android:layout_width="0dp"
                                        android:layout_height="54dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:text="Use backup"
                                        android:layout_weight="1"
                                        android:textAllCaps="false"
                                        android:layout_marginStart="10dp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp">
                                    <Button
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_cyan_bright"
                                        android:gravity="center"
                                        android:id="@+id/errorDetailsButton"
                                        android:background="@drawable/error_secondary_button_background"
                                        android:layout_width="0dp"
                                        android:layout_height="54dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:text="Technical details"
                                        android:layout_weight="1"
                                        android:textAllCaps="false"/>
                                    <Button
                                        android:textStyle="bold"
                                        android:textColor="@color/hcf_cyan_bright"
                                        android:gravity="center"
                                        android:id="@+id/errorSupportButton"
                                        android:background="@drawable/error_secondary_button_background"
                                        android:layout_width="0dp"
                                        android:layout_height="54dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:text="Get Support"
                                        android:layout_weight="1"
                                        android:textAllCaps="false"
                                        android:layout_marginStart="10dp"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/hcf_muted"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="HCF APP // ERRORSYS"
                                    android:layout_weight="1"
                                    android:fontFamily="monospace"/>
                                <TextView
                                    android:textSize="9sp"
                                    android:textColor="@color/hcf_cyan_bright"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="forum.harleytg.com"
                                    android:fontFamily="monospace"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottomNav"
            android:background="@drawable/bottom_bar_background"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:elevation="18dp">
            <TextView
                android:id="@+id/bottomHome"
                android:text="Home"
                android:drawableTop="@drawable/fa_house"
                android:drawablePadding="2dp"
                android:contentDescription="Forum home"
                style="@style/HcfBottomNavItem"/>
            <TextView
                android:id="@+id/bottomBrowse"
                android:text="Browse"
                android:drawableTop="@drawable/fa_list"
                android:drawablePadding="2dp"
                android:contentDescription="Browse discussions"
                style="@style/HcfBottomNavItem"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/hcf_bg"
                android:id="@+id/bottomCreate"
                android:background="@drawable/bottom_nav_action_background"
                android:text="Post"
                android:drawableTop="@drawable/fa_plus"
                android:drawablePadding="2dp"
                android:contentDescription="Start a discussion"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/HcfBottomNavItem"/>
            <TextView
                android:id="@+id/bottomAlerts"
                android:text="Alerts"
                android:drawableTop="@drawable/fa_bell"
                android:drawablePadding="2dp"
                android:contentDescription="Forum alerts"
                style="@style/HcfBottomNavItem"/>
            <TextView
                android:id="@+id/bottomProfile"
                android:text="Me"
                android:drawableTop="@drawable/fa_user"
                android:drawablePadding="2dp"
                android:contentDescription="My forum profile"
                style="@style/HcfBottomNavItem"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/drawerScrim"
        android:background="@color/hcf_scrim"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:id="@+id/drawerPanel"
        android:background="@drawable/drawer_background"
        android:padding="@dimen/drawer_padding"
        android:visibility="gone"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:elevation="30dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/drawer_logo"
                android:layout_height="@dimen/drawer_logo"
                android:src="@drawable/htg_app_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="@dimen/app_header_title_text"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_text"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harley&apos;s Clan Forum [Beta]"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/hcf_cyan"
                    android:ellipsize="end"
                    android:id="@+id/drawerHostText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Primary • forum.harleytg.com"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="@color/hcf_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/drawerIdentityCard"
            android:background="@drawable/identity_card_background"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minHeight="@dimen/identity_card_min_height"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/drawerIdentityAvatar"
                android:background="@drawable/identity_avatar_background"
                android:padding="6dp"
                android:layout_width="@dimen/identity_avatar_size"
                android:layout_height="@dimen/identity_avatar_size"
                android:src="@drawable/htg_app_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:cropToPadding="false"
                android:contentDescription="Current forum identity avatar"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="11dp">
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forum Identity"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_text"
                    android:ellipsize="end"
                    android:id="@+id/drawerIdentityText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Guest_Protocol"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/hcf_cyan"
                    android:ellipsize="end"
                    android:id="@+id/drawerIdentityUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Guest session"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/hcf_muted"
                    android:ellipsize="end"
                    android:id="@+id/drawerIdentityMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Guest forum identity"
                    android:maxLines="1"/>
                <HorizontalScrollView
                    android:id="@+id/drawerLinkedAccounts"
                    android:visibility="visible"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fillViewport="false">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="9sp"
                            android:textColor="@color/hcf_text"
                            android:gravity="center_vertical"
                            android:id="@+id/drawerProviderEmail"
                            android:background="@drawable/provider_chip_background"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:drawablePadding="4dp"
                            android:drawableStart="@drawable/ic_provider_email"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:layout_marginEnd="5dp"/>
                        <TextView
                            android:textSize="9sp"
                            android:textColor="@color/hcf_text"
                            android:gravity="center_vertical"
                            android:id="@+id/drawerProviderDiscord"
                            android:background="@drawable/provider_chip_background"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discord"
                            android:drawablePadding="4dp"
                            android:drawableStart="@drawable/ic_provider_discord"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"/>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
            <ImageButton
                android:layout_gravity="top"
                android:id="@+id/drawerSecurity"
                android:background="@drawable/nav_button_background"
                android:padding="7dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/fa_shield"
                android:scaleType="centerInside"
                android:contentDescription="Account Security"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <View
            android:background="@color/hcf_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_muted"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forum controls"
                    android:paddingStart="6dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">
                    <Button
                        android:textSize="11sp"
                        android:id="@+id/drawerSwitchHost"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="0dp"
                        android:text="Primary server"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/fa_right_left"
                        android:layout_marginEnd="5dp"
                        style="@style/HcfDrawerItem"/>
                    <Button
                        android:textSize="11sp"
                        android:id="@+id/drawerOpenExternal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="0dp"
                        android:text="Page actions"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/fa_arrow_up_right_from_square"
                        android:layout_marginStart="5dp"
                        style="@style/HcfDrawerItem"/>
                </LinearLayout>
                <Button
                    android:id="@+id/drawerHome"
                    android:visibility="gone"
                    android:text="Forum Home"
                    style="@style/HcfDrawerItem"/>
                <Button
                    android:id="@+id/drawerShare"
                    android:visibility="gone"
                    android:text="Share Current Page"
                    style="@style/HcfDrawerItem"/>
                <Button
                    android:id="@+id/drawerNotifications"
                    android:visibility="gone"
                    android:text="Notifications"
                    style="@style/HcfDrawerItem"/>
                <TextView
                    android:id="@+id/drawerNotificationCountBadge"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="1dp"/>
                <Button
                    android:id="@+id/drawerLogs"
                    android:visibility="gone"
                    android:text="Diagnostics &amp; Logs"
                    style="@style/HcfDrawerItem"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/hcf_muted"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="App"
                    android:paddingStart="6dp"/>
                <Button
                    android:id="@+id/drawerSettings"
                    android:text="App Settings"
                    android:drawableStart="@drawable/fa_gear"
                    style="@style/HcfDrawerItem"/>
                <Button
                    android:id="@+id/drawerSupport"
                    android:text="Contact Support"
                    android:drawableStart="@drawable/fa_envelope"
                    style="@style/HcfDrawerItem"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/hcf_hint"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap outside the menu or press Back to close."
                    android:paddingStart="6dp"/>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/hcf_hint"
            android:gravity="center"
            android:id="@+id/drawerVersionText"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Harley&apos;s Clan Forum v1.0 [Development Build / Beta]"/>
    </LinearLayout>
</FrameLayout>
