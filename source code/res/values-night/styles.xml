<resources>
    <style name="Theme.HCF" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/hcf_bg</item>
        <item name="android:navigationBarColor">@color/hcf_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/hcf_cyan</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:alertDialogTheme">@style/Theme.HCF.Dialog.Alert</item>
    </style>

    <style name="Theme.HCF.Dialog.Alert" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">@color/hcf_cyan_bright</item>
        <item name="android:textColorPrimary">@color/hcf_text</item>
        <item name="android:textColorSecondary">@color/hcf_muted</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="HcfDrawerItem" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/drawer_item_height</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/drawer_item_background</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/hcf_text</item>
        <item name="android:textSize">@dimen/drawer_item_text</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <style name="HcfBottomNavItem" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bottom_nav_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/hcf_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
