<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/hcf_identity_pressed"/><stroke android:width="1dp" android:color="@color/hcf_cyan"/><corners android:radius="14dp"/><padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/hcf_identity_bg"/><stroke android:width="1dp" android:color="@color/hcf_border"/><corners android:radius="14dp"/><padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/></shape>
    </item>
</selector>
