<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hcf_settings_button_pressed"/>
            <stroke
                android:width="1dp"
                android:color="@color/hcf_cyan"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hcf_settings_button_bg"/>
            <stroke
                android:width="1dp"
                android:color="@color/hcf_cyan"/>
        </shape>
    </item>
</selector>
